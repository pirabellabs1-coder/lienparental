# Variables d'environnement de Lien Parental.
# Inventaire vérifié le 26/10/2026 (grep process.env dans app/, lib/, components/, middleware.ts, next.config.mjs).
# Production : à saisir dans Vercel > Settings > Environment Variables (voir docs/DEPLOIEMENT.md §2).
# Jamais de secret dans une variable NEXT_PUBLIC_ (elles sont envoyées au navigateur).

# Supabase (projet en région UE : eu-west-1, Irlande)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Facultatif : longueur du code d'inscription = réglage Supabase « Email OTP Length » (6 à 10, 6 recommandé).
# Connue, elle permet de valider automatiquement un code collé ; vide : validation au clic (l'app accepte 6 à 10).
NEXT_PUBLIC_EMAIL_OTP_LENGTH=

# Stripe : valeurs produites par `npx --yes tsx scripts/stripe-setup.ts` (voir docs/STRIPE.md).
# Sans STRIPE_SECRET_KEY : « Mon abonnement » affiche « Paiement bientôt disponible » (aucun bouton cassé).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Formule Coparentalité+ (19,99 €/mois ; annuel proposé 189 €/an). Vides = formule non vendable
# (le paiement répond « service momentanément indisponible »). Voir docs/MISE_EN_SERVICE.md §2.2 bis.
STRIPE_PRICE_COPARENTALITE_MONTHLY=
STRIPE_PRICE_COPARENTALITE_YEARLY=
# Taxe automatique Stripe Tax : « on » pour l'activer (Stripe Tax doit être activé dans le Dashboard ;
# l'adresse de facturation devient alors obligatoire au paiement). Toute autre valeur ou vide : désactivée.
STRIPE_TAX=
# Configuration du portail client Stripe (identifiant bpc_...). Vide ou invalide : configuration par défaut du compte.
STRIPE_PORTAL_CONFIGURATION=
# Jours pendant lesquels un abonnement impayé (past_due) garde ses avantages. Entier 0 à 60, défaut 14.
BILLING_GRACE_DAYS=14

# IA — Coach parental (Anthropic, serveur uniquement ; voir docs/MISE_EN_SERVICE.md §3)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Optionnels : low | medium | high ; AI_FALLBACKS=off coupe le repli serveur en cas de refus
AI_ANALYSIS_EFFORT=medium
AI_CHAT_EFFORT=low
AI_FALLBACKS=

# Mails (Resend)
RESEND_API_KEY=
MAIL_FROM="Lien Parental <no-reply@lienparental.fr>"

# App
NEXT_PUBLIC_APP_URL=https://lienparental.fr
APP_ENCRYPTION_KEY=

# Partage avocat / liens de partage (app/api/partage) : secret HMAC des clés d'accès.
# 32 octets aléatoires (openssl rand -base64 32), distinct des autres secrets. À défaut : APP_ENCRYPTION_KEY ;
# sans les deux, secret propre à l'instance (les accès expirent à chaque redémarrage ou changement d'instance).
LAWYER_SHARE_SECRET=

# Sel HMAC des empreintes d'IP (jamais l'IP en clair) : preuve jointe à un témoignage et clés du limiteur de débit
# partagé (migration 0390). Facultatif mais conseillé (openssl rand -base64 32) : à défaut APP_ENCRYPTION_KEY ;
# sans les deux, aucune empreinte IP n'est stockée avec les témoignages.
IP_HASH_SALT=

# Page /don : URL de la plateforme de don (HelloAsso, Stripe Payment Link…). Vide : « La page de don ouvre très bientôt ».
NEXT_PUBLIC_DON_URL=

# Comptes de démonstration (voir docs/COMPTES_DEMO.md) : on | off. Par défaut : actif en dev, coupé en production.
NEXT_PUBLIC_DEMO_MODE=

# Google (chantier G, voir docs/MISE_EN_SERVICE.md §5). Serveur uniquement, jamais NEXT_PUBLIC_.
# « Continuer avec Google » (connexion) : client OAuth saisi dans Supabase > Authentication > Providers > Google (aucune variable ici).
# Synchronisation Google Agenda : client OAuth « Application Web » dédié.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit être exactement <NEXT_PUBLIC_APP_URL>/api/integrations/google/calendar/callback (déclarée dans Google Cloud)
GOOGLE_REDIRECT_URI=https://lienparental.fr/api/integrations/google/calendar/callback
# 32 octets base64 (openssl rand -base64 32) : chiffrement AES-256-GCM des jetons Google. À défaut : APP_ENCRYPTION_KEY.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Tâche planifiée (toutes les 5 min, déclarée dans vercel.json) qui écoule la file Google Agenda de tous les utilisateurs :
# GET /api/integrations/google/calendar/cron avec « Authorization: Bearer <CRON_SECRET> » (envoyé automatiquement par Vercel Cron).
# 32 caractères aléatoires minimum conseillés (openssl rand -hex 32), 16 au minimum. Vide = route désactivée (503).
CRON_SECRET=

# Tableau de bord admin (chantier F, voir docs/MISE_EN_SERVICE.md §6). Facultatifs, serveur uniquement.
# Coût moyen estimé d'une analyse Coach IA en euros (défaut 0.07).
ADMIN_AI_COST_PER_ANALYSIS_EUR=
# Budget IA mensuel en euros : alerte à 80 % puis 100 %. Vide = pas d'alerte de budget.
ADMIN_AI_MONTHLY_BUDGET_EUR=

# Coffre-fort verrouillé (chantier D, voir docs/MISE_EN_SERVICE.md §7). Serveur uniquement, jamais NEXT_PUBLIC_.
# Clé maîtresse ≥ 32 caractères (openssl rand -base64 48) : signe le cookie de session coffre et poivre les codes.
# À défaut : APP_ENCRYPTION_KEY. Absente en production : coffre fermé (fail closed). La changer oblige à redéfinir les codes.
VAULT_LOCK_SECRET=
# WebAuthn (empreinte / visage). Production : domaine exact du site, sans schéma ni port (ex. lienparental.fr).
WEBAUTHN_RP_ID=lienparental.fr
# Origine(s) autorisée(s), séparées par des virgules (ex. https://lienparental.fr). À défaut : NEXT_PUBLIC_APP_URL.
WEBAUTHN_ORIGIN=https://lienparental.fr

# Contenus administrables (guides, modèles PDF, blog ; voir docs/MISE_EN_SERVICE.md §8)
# Aucune variable propre : URL publique utilisée pour canonical, Open Graph, JSON-LD et sitemap du blog.
NEXT_PUBLIC_SITE_URL=https://lienparental.fr

# Liaison des parents (chantier I, voir docs/MISE_EN_SERVICE.md §9 et docs/FAMILLE.md)
# Aucune variable propre. Réutilise : NEXT_PUBLIC_APP_URL (liens d'invitation), RESEND_API_KEY + MAIL_FROM
# (e-mails ; sans clé, journalisés), SUPABASE_SERVICE_ROLE_KEY (notifications « acceptée / retiré », avatars),
# APP_ENCRYPTION_KEY (santé partagée et fusion des fiches).

# Notifications (voir docs/NOTIFICATIONS.md). Web Push : paire VAPID générée UNE fois avec
#   npx web-push generate-vapid-keys
# La clé publique est lue par le navigateur (NEXT_PUBLIC_), la clé privée reste serveur. Vides : pas de push
# (in-app et e-mails fonctionnent). Changer de paire oblige chaque appareil à réactiver les notifications.
# Réutilise aussi CRON_SECRET (tâche /api/cron/notifications toutes les 5 min, vercel.json), IP_HASH_SALT
# (empreinte d'appareil de l'alerte « nouvelle connexion »), RESEND_API_KEY + MAIL_FROM, SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@lienparental.fr

# --- Non utilisées par le code actuel (lues nulle part ; vérifié par grep le 26/10/2026) --------------------
# Conservées en commentaire pour mémoire : ne pas les saisir dans Vercel.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Checkout hébergé : aucune clé publique nécessaire côté navigateur
# OCR_API_KEY=                          # la lecture des captures passe par la vision de Claude
